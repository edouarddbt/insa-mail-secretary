# --- Messagerie INSA Rouen (Partage / Zimbra) ---
IMAP_HOST=partage.insa-rouen.fr
IMAP_PORT=993
IMAP_USER=prenom.nom@insa-rouen.fr
IMAP_PASSWORD=ton_mot_de_passe_insa
IMAP_FOLDER=INBOX

# --- API Gemini (Google AI Studio : https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=ta_cle_api_gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash

# --- Bot Telegram ---
# 1. Crée un bot avec @BotFather pour avoir le token
# 2. Envoie un message à ton bot puis récupère ton chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# --- Comportement & Tri ---
TIMEZONE=Europe/Paris
DIGEST_TIME=20:00
DIGEST_SEND_WHEN_EMPTY=false
IDLE_TIMEOUT_SECONDS=600
POLL_FALLBACK_SECONDS=300
# Au tout premier lancement, ignorer les anciens mails (0 = uniquement les nouveaux à partir de maintenant)
INITIAL_LOOKBACK_HOURS=0
# Ignorer les mails plus vieux que N heures s'ils apparaissent dans INBOX (évite les notifs lors d'une restauration depuis la corbeille)
MAX_EMAIL_AGE_HOURS=12
# Déplacer automatiquement les newsletters/spams de INBOX vers le dossier Archive
AUTO_ARCHIVE_NEWSLETTERS=true
# Laisser vide pour détecter/créer automatiquement "Archive"
ARCHIVE_FOLDER=
# Rappel le soir des mails importants restés sans réponse sur les N derniers jours (0 = désactivé)
REPLY_REMINDER_DAYS=5
# Inclure automatiquement au récap du soir les mails reçus depuis J-N (1 = depuis hier, même au premier lancement)
DIGEST_LOOKBACK_DAYS=1

# --- Personnalisation (optionnel) ---
# Contexte donné à l'IA pour affiner le tri (ton département, année, mots-clés...)
USER_CONTEXT=Étudiant en 4ème année au département ITI (ITI4) à l'INSA Rouen Normandie. Mails urgents/importants : professeurs, scolarité, administration, convocations, notes, absences, stages, alternance, projets, événements obligatoires pour les 4A/ITI4, ou mails qui me sont adressés personnellement. Newsletters/bruit : diffusions générales optionnelles de l'école, associations étudiantes, BDE, événements campus non obligatoires.

# Expéditeurs ou domaines toujours notifiés en direct (séparés par des virgules)
VIP_SENDERS=scolarite@insa-rouen.fr
# Expéditeurs ou domaines toujours envoyés au récap du soir sans appel IA (séparés par des virgules)
MUTED_SENDERS=bde@insa-rouen.fr,newsletter@

# --- Base locale ---
DB_PATH=data/secretary.db
