[Unit]
Description=Secretaire IA INSA Rouen (IMAP -> Gemini -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/insa-mail-secretary
EnvironmentFile=/opt/insa-mail-secretary/.env
ExecStart=/opt/insa-mail-secretary/.venv/bin/python -m src.main
Restart=always
RestartSec=15
MemoryMax=350M
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
